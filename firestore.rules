rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /inquiries/{leadId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'name', 'number', 'email', 'address', 'zipCode', 'propertyType',
          'ownership', 'timeline', 'financingInterest', 'electricBill',
          'sunlightExposure', 'consent', 'consentText', 'consentVersion',
          'leadStatus', 'phoneVerified', 'pageUrl', 'source', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'name', 'number', 'email', 'address', 'zipCode', 'propertyType',
          'ownership', 'timeline', 'financingInterest', 'description',
          'electricBill', 'sunlightExposure', 'consent', 'consentText',
          'consentVersion', 'leadStatus', 'phoneVerified', 'pageUrl',
          'source', 'createdAt'
        ]) &&
        request.resource.data.consent == true &&
        request.resource.data.leadStatus == 'new' &&
        request.resource.data.phoneVerified == false &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.number is string &&
        request.resource.data.number.size() >= 7 &&
        request.resource.data.number.size() <= 30 &&
        request.resource.data.zipCode is string &&
        request.resource.data.zipCode.matches('^[0-9]{5}(-[0-9]{4})?$') &&
        request.resource.data.address is string &&
        request.resource.data.address.size() <= 300 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 2000;

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
